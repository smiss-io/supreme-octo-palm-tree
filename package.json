{
  "name": "kidspark",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate --schema=packages/db/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=packages/db/schema.prisma",
    "db:push": "prisma db push --schema=packages/db/schema.prisma",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "prisma studio --schema=packages/db/schema.prisma",
    "audit:security": "bash scripts/audit.sh",
    "worker": "tsx workers/index.ts",
    "typecheck": "tsc --noEmit"
  },
